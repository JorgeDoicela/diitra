!backend/diitra_api/uploads/firmas/.gitkeep
backend/diitra_api/uploads/signatures/*
!backend/diitra_api/uploads/signatures/.gitkeep

# Backups locales (archivos .sql, .zip, etc.)
backend/diitra_api/backups/*
