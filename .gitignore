# ==============================
# Backend (.NET C#)
# ==============================
[Bb]in/
[Oo]bj/
[Tt]est[Rr]esults/
*.vsconfig
*.log

# No ignorar el código nativo de infra
!backend/

# Configuraciones con secretos en Backend
backend/diitra_api/appsettings.json
backend/diitra_api/appsettings.*.json
!backend/diitra_api/appsettings.template.json
!backend/diitra_api/appsettings.*.template.json

# ==============================
# Node / Frontend (React / Vite / Expo)
# ==============================
node_modules/
dist/
dist-ssr/
build/
.expo/
web-build/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Despliegues y Backups Locales
backend/publish/
scripts/despliegue/backups/

# Archivos subidos y generados (PDFs, PNGs)
